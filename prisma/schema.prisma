generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  DOADOR
  INSTITUICAO
}

model User {
  id         String      @id @default(cuid())
  nome       String
  email      String      @unique
  senha      String
  tipo       TipoUsuario
  campanhas  Campanha[]  @relation("InstituicaoCampanhas")
  doacoes    Doacao[]    @relation("DoadorDoacoes")
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
}

model Campanha {
  id             String    @id @default(cuid())
  titulo         String
  descricao      String
  localizacao    String
  data_inicio    DateTime
  data_fim       DateTime
  instituicao    User      @relation("InstituicaoCampanhas", fields: [instituicao_id], references: [id])
  instituicao_id String
  doacoes        Doacao[]
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model Doacao {
  id           String    @id @default(cuid())
  descricao    String
  quantidade   Int
  foto_url     String?
  campanha     Campanha  @relation(fields: [campanha_id], references: [id])
  campanha_id  String
  doador       User      @relation("DoadorDoacoes", fields: [doador_id], references: [id])
  doador_id    String
  data_doacao  DateTime  @default(now())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}
